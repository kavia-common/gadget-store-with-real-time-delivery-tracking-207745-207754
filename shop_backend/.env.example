# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# CORS (optional)
ALLOWED_ORIGINS=*
ALLOWED_HEADERS=Content-Type,Authorization
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_MAX_AGE=3600

# MySQL (required; provided by database container)
MYSQL_URL=localhost
MYSQL_PORT=5000
MYSQL_USER=appuser
MYSQL_PASSWORD=********
MYSQL_DB=myapp
